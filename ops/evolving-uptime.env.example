# Set these values on the agreed Linux host in /etc/evolving-uptime.env.
CHECK_URL=http://127.0.0.1:8080/
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=5

# Optional: a webhook that accepts JSON shaped as {"text": "..."}.
# Keep this value private; do not commit the real endpoint.
ALERT_WEBHOOK_URL=
